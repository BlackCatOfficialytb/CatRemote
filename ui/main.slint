import { Button, VerticalBox, LineEdit, TabWidget } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "CatRemote";
    width: 400px;
    height: 300px;
    
    in property <string> connection-state: "Disconnected";
    in property <string> host-code: "123456";
    
    callback connect-clicked(string, string);
    callback disconnect-clicked();

    TabWidget {
        Tab {
            title: "Host";
            VerticalBox {
                alignment: center;
                Text {
                    text: "Your Connection Code:";
                    horizontal-alignment: center;
                    font-size: 16px;
                }
                Text {
                    text: root.host-code;
                    horizontal-alignment: center;
                    font-size: 32px;
                    font-weight: 700;
                    color: #007bff;
                }
                Text {
                    text: "Status: " + root.connection-state;
                    horizontal-alignment: center;
                    color: root.connection-state == "Connected" ? #28a745 : #6c757d;
                }
            }
        }
        Tab {
            title: "Client";
            VerticalBox {
                alignment: start;
                Text {
                    text: "Connect to Host";
                    font-size: 18px;
                    font-weight: 600;
                }
                ip-input := LineEdit {
                    placeholder-text: "Host IP (e.g., 192.168.1.100)";
                }
                code-input := LineEdit {
                    placeholder-text: "Connection Code (6 digits)";
                }
                Button {
                    text: root.connection-state == "Disconnected" ? "Connect" : "Disconnect";
                    clicked => {
                        if (root.connection-state == "Disconnected") {
                            root.connect-clicked(ip-input.text, code-input.text);
                        } else {
                            root.disconnect-clicked();
                        }
                    }
                }
                Text {
                    text: "Status: " + root.connection-state;
                    color: root.connection-state == "Connected" ? #28a745 : #6c757d;
                }
            }
        }
    }
}
